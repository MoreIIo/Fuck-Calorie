{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fuck Calorie",
  "version": "0.1.0",
  "identifier": "io.github.moreiio.fuckcalorie",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Fuck Calorie",
        "width": 1200,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "category": "HealthcareAndFitness",
    "shortDescription": "Tracker de calories gratuit et open source",
    "copyright": "Maëlle Leynaud — MPL-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
